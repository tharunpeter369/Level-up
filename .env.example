# Copy to .env and adjust. Local development values only; never commit real secrets.

# Docker Compose (host ports chosen to avoid a locally installed Postgres/Redis)
POSTGRES_USER=skillforge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=skillforge
POSTGRES_PORT=5433
REDIS_PORT=6380

# Used by the API
DATABASE_URL=postgres://skillforge:change-me@localhost:5433/skillforge
REDIS_URL=redis://localhost:6380
